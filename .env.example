# Budget Governor -- environment configuration reference.
#
# Copy to .env (docker compose reads .env automatically) and adjust as
# needed. Every variable has a safe default baked into docker-compose.yml
# for the mock-provider / no-API-keys demo path -- you only need to set
# anything here to point at real infrastructure or real LLM providers.

# ---------------------------------------------------------------------------
# Core infrastructure
# ---------------------------------------------------------------------------

# Shared by the gateway (lib/pq), control plane (asyncpg, via a derived
# +asyncpg DSN, see controlplane/app/config.py), reconciliation
# (asyncpg), and scripts/migrate.py (psycopg). One DSN, one schema.
POSTGRES_DSN=postgres://budget_governor:budget_governor@postgres:5432/budget_governor?sslmode=disable
POSTGRES_USER=budget_governor
POSTGRES_PASSWORD=budget_governor
POSTGRES_DB=budget_governor

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# Gateway (see gateway/internal/config/config.go for the full set)
# ---------------------------------------------------------------------------

GATEWAY_HTTP_ADDR=:8080
GATEWAY_METRICS_ADDR=:9090
ADVISOR_URL=http://advisor:8082
ADVISOR_TIMEOUT_MS=300
AUTH_CACHE_TTL_SECONDS=60
BUDGET_CACHE_TTL_SECONDS=30

# Mock provider's simulated upstream latency bounds (milliseconds). This
# is what docker-compose runs against by default -- no API keys needed.
MOCK_PROVIDER_LATENCY_MIN_MS=50
MOCK_PROVIDER_LATENCY_MAX_MS=500

# ---------------------------------------------------------------------------
# Real LLM provider keys -- OPTIONAL. Leave blank to run entirely on the
# Mock provider (docker-compose's default). Setting these does NOT change
# which provider a request hits -- that's determined by the `model` field
# in each request (gpt-*/o1/o3/o4* -> OpenAI, claude-* -> Anthropic,
# mock-* -> Mock, always) -- it just makes the gateway able to actually
# reach OpenAI/Anthropic for those model names instead of failing with a
# 401 from the upstream.
# ---------------------------------------------------------------------------

# Used for real Chat Completions calls (gateway/internal/provider/openai.go).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Used for real Messages API calls (gateway/internal/provider/anthropic.go).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ---------------------------------------------------------------------------
# Cost advisor
# ---------------------------------------------------------------------------

# "mock" (default, no keys needed) | "openai" | "anthropic". Selecting
# openai/anthropic without the matching API key above silently falls
# back to mock -- see advisor/app/config.py.
ADVISOR_LLM_PROVIDER=mock
ADVISOR_OPENAI_MODEL=gpt-4o-mini
ADVISOR_ANTHROPIC_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# Reconciliation
# ---------------------------------------------------------------------------

# Fraction (0.05 = 5%) drift between gateway-observed and provider-billed
# spend that triggers an incident. See docs/RUNBOOK.md#reconciliationdrifthigh.
RECONCILIATION_DRIFT_THRESHOLD_PCT=0.05

# Organization-scoped ADMIN keys (distinct from the regular API keys
# above) for the usage/cost reporting endpoints -- see
# reconciliation/usage_providers/. Leave blank to use MockUsageProvider,
# which derives realistic "provider-reported" figures from the gateway's
# own observed spend (see its module docstring for why this is a
# deliberate design, not just a stub).
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=

# ---------------------------------------------------------------------------
# Control plane
# ---------------------------------------------------------------------------

# Shared secret for POST /v1/tenants (provisioning a brand new tenant,
# which by definition has no admin API key of its own yet -- see
# controlplane/app/auth/platform.py). Change this before any non-local
# deployment; scripts/seed.py reads it to bootstrap the demo tenants.
PLATFORM_BOOTSTRAP_TOKEN=dev-only-change-me

ENVIRONMENT=development

{
  "title": "Gateway Health",
  "uid": "bg-gateway-health",
  "tags": ["budget-governor"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(budget_governor_gateway_requests_total[1m]))",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "expr": "sum by (decision) (rate(budget_governor_gateway_requests_total[1m]))",
          "legendFormat": "{{decision}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency p50 / p95 / p99 (allowed requests)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(budget_governor_gateway_request_duration_seconds_bucket{decision=\"allowed\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(budget_governor_gateway_request_duration_seconds_bucket{decision=\"allowed\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(budget_governor_gateway_request_duration_seconds_bucket{decision=\"allowed\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Rejection rate by reason (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (reason) (rate(budget_governor_gateway_rejections_total[5m])) / ignoring(reason) group_left sum(rate(budget_governor_gateway_requests_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Provider error rate by status class",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (provider, status_class) (rate(budget_governor_gateway_provider_errors_total[5m]))",
          "legendFormat": "{{provider}} {{status_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Advisor invocations by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(budget_governor_gateway_advisor_invocations_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Spend events dropped (buffer overflow)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "rate(budget_governor_gateway_spend_write_dropped_total[5m])",
          "legendFormat": "dropped/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "p99 latency (allowed requests) vs. 10ms budget",
      "type": "stat",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(budget_governor_gateway_request_duration_seconds_bucket{decision=\"allowed\"}[5m])) by (le))",
          "refId": "A"
        }
      ]
    }
  ]
}
